<!DOCTYPE html>
<html color-mode="user">
    <head>
        <title>{{ head_title }}</title>
        {{ include('head.html.twig') }}
    </head>
    <body>
        <header>
            <nav>
                <a href="{{ home_url }}"><img src="{{ base }}/favicon-32x32.png" alt="Home" /></a>
                <ul>
                    {{ nav_breadcrumb|raw }}
                </ul>
            </nav>
            <h1>{{ site_name }}</h1>
            <p>{{ site_desc }}</p>
        </header>
        <main>
            {% for entry in entries %}
                <div>
                    <small>{{ entry.date_str }}</small>
                    <h2>
                        <a href="{{ entry.url }}">{{ entry.title }}</a>
                    </h2>
                    <article>
                        {{ entry.preview|raw }}
                    </article>
                    {% if entry.breadcrumb %}
                        <small>
                            Published under: {{ entry.breadcrumb|raw }}
                        </small>
                    {% endif %}
                    <hr>
                </div>
            {% endfor %}
        </main>
        <footer>
            {% if pages %}
                <nav>
                    Page
                    <ul>
                        {% for p in pages %}
                            {% if p.current %}
                                <li>{{ p.n }}</li>
                            {% else %}
                                <li><a href="{{ p.url }}">{{ p.n }}</a></li>
                            {% endif %}
                        {% endfor %}
                    </ul>
                </nav>
            {% endif %}

            <small>
                Copyright {{ site_name }}
            </small>
        </footer>
    </body>
</html>
